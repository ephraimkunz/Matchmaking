#!/usr/bin/env bash
# Pre-push gate mirroring .github/workflows/ci.yaml.
# Activated per-clone with: git config core.hooksPath .githooks
set -exuo pipefail

cargo fmt --all --quiet -- --check
cargo clippy --all-targets --quiet -- -D warnings
cargo build --release --quiet
wasm-pack --quiet build --target web --out-dir /tmp/wasm-pkg
cargo test --quiet
